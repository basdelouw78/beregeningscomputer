####################################################################
# RainMaster — voorbeeld secrets.yaml
#
# Dit bestand hoort NIET met echte waarden in een publieke repo terecht
# te komen. In Home Assistant's ESPHome-dashboard deel je normaal gesproken
# één secrets.yaml voor al je apparaten (/config/esphome/secrets.yaml) —
# vul daar deze drie sleutels in. Zie README.md, "ESPHome-variant" ->
# "Installeren & updaten".
####################################################################

wifi_ssid: "JouwWifiNaam"
wifi_password: "JouwWifiWachtwoord"

# Willekeurige, base64-gecodeerde 32-byte sleutel. Laat ESPHome er zelf een
# voorstellen (compileer met dit veld leeg en lees de foutmelding), of
# genereer er lokaal een met:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "vul-hier-je-eigen-sleutel-in"
