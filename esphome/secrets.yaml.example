# Kopieer dit bestand naar secrets.yaml (die staat al in .gitignore)
# en vul je eigen waarden in. Nooit secrets.yaml zelf committen.

wifi_ssid: "JouwWifiNaam"
wifi_password: "JouwWifiWachtwoord"

# Wachtwoord voor de tijdelijke fallback-AP (als STA-WiFi mislukt)
ap_password: "verander-mij-12345678"

# Wachtwoord voor OTA-updates (esphome upload / esphome run)
ota_password: "verander-dit-ota-wachtwoord"

# 32-byte base64 encryptiesleutel voor de native API-verbinding met
# Home Assistant. Genereer er een met: esphome secrets generate
# of in Python: base64.b64encode(os.urandom(32)).decode()
api_encryption_key: "VUL_HIER_EEN_GEGENEREERDE_32_BYTE_BASE64_SLEUTEL_IN"
