# Kopieer dit bestand naar secrets.yaml (die staat al in .gitignore)
# en vul je eigen waarden in. Nooit secrets.yaml zelf committen.
#
# Let op: er staat hier bewust GEEN wifi_ssid/wifi_password in. Dit board
# wordt na het flashen (en na elke OTA-update) via het toegangspunt
# "RainMaster-Fallback" + captive portal aan je wifi gekoppeld — dat wordt
# opgeslagen op het apparaat zelf, niet in de firmware. Zie README.md
# ("Eerste keer wifi instellen").

# Wachtwoord voor het tijdelijke toegangspunt (AP) dat het apparaat opzet
# zolang er nog geen wifi is ingesteld.
ap_password: "verander-mij-12345678"

# Wachtwoord voor lokale OTA-updates via de ESPHome-dashboard/CLI
# (esphome upload / esphome run). Los van de GitHub-gebaseerde auto-update.
ota_password: "verander-dit-ota-wachtwoord"

# 32-byte base64 encryptiesleutel voor de native API-verbinding met
# Home Assistant. Genereer er een met: esphome secrets generate
# of in Python: base64.b64encode(os.urandom(32)).decode()
api_encryption_key: "VUL_HIER_EEN_GEGENEREERDE_32_BYTE_BASE64_SLEUTEL_IN"
