<%- include('partials/header') %>
<a class="back" href="/tutorials"><%- icon('chev-left') %> Tutorials</a>
<div class="page-head">
  <div><h1>Tutorial uploaden</h1><p>Leg uit hoe je iets repareert of een probleem oplost. Foto's en video's helpen enorm!</p></div>
</div>

<form class="card" method="post" action="/tutorials" enctype="multipart/form-data" id="tutorial-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field"><label for="t-title">Titel</label>
    <input id="t-title" name="title" type="text" required maxlength="150" placeholder="Bijv. Lekkende kraan in het toilet repareren"></div>
  <div class="field"><label for="t-cat">Categorie</label>
    <select id="t-cat" name="category">
      <% categories.forEach(c => { %><option><%= c %></option><% }) %>
    </select></div>
  <div class="field"><label for="t-desc">Korte omschrijving</label>
    <textarea id="t-desc" name="description" maxlength="2000" placeholder="Wat is het probleem en wat heb je nodig (gereedschap, onderdelen)?"></textarea></div>
  <div class="field"><label for="t-steps">Stappen</label>
    <textarea id="t-steps" name="steps" maxlength="20000" style="min-height:180px" placeholder="Zet elke stap op een nieuwe regel, bijvoorbeeld:&#10;Draai de hoofdkraan dicht&#10;Schroef de kraankop los&#10;Vervang het leertje"></textarea>
    <p class="hint">Elke regel wordt een genummerde stap.</p></div>
  <div class="field">
    <span style="display:block;font-weight:600;margin-bottom:.35rem">Foto's, video's of PDF</span>
    <label class="dropzone" id="dropzone">
      <input type="file" name="files" id="t-files" multiple accept="image/*,video/*,application/pdf">
      <%- icon('upload', 'ic-lg') %>
      <strong>Tik om bestanden te kiezen</strong>
      <span class="small">of maak direct een foto · max. 8 bestanden, 100 MB per stuk</span>
    </label>
    <ul class="file-list" id="file-list"></ul>
  </div>
  <button class="btn block" type="submit" id="t-submit"><%- icon('upload') %> Tutorial plaatsen</button>
</form>
<%- include('partials/footer') %>
