<%- include('partials/header') %>
<a class="back" href="/vragen"><%- icon('chev-left') %> Alle vragen</a>

<article class="card">
  <div class="item-head">
    <h1 style="font-size:1.35rem;overflow-wrap:anywhere"><%= question.title %></h1>
    <% if (question.solved) { %><span class="badge ok"><%- icon('check') %> Opgelost</span><% } else { %><span class="badge warn">Open</span><% } %>
  </div>
  <p class="small muted"><%= question.user_name || 'Onbekend' %> · <%= formatDateTime(question.created_at) %></p>
  <% if (question.body) { %><p class="post-body"><%= question.body %></p><% } %>
  <% if (question.user_id === user.id || user.is_admin) { %>
    <div class="btn-row">
      <form class="inline" method="post" action="/vragen/<%= question.id %>/opgelost">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn secondary sm" type="submit"><%- icon('check') %> <%= question.solved ? 'Toch nog open' : 'Markeer als opgelost' %></button>
      </form>
      <form class="inline" method="post" action="/vragen/<%= question.id %>/verwijderen" data-confirm="Deze vraag en alle antwoorden verwijderen?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn danger sm" type="submit"><%- icon('trash') %> Verwijderen</button>
      </form>
    </div>
  <% } %>
</article>

<h2 style="margin-top:1.5rem"><%= answers.length %> antwoord<%= answers.length === 1 ? '' : 'en' %></h2>
<div class="stack">
  <% answers.forEach(a => { %>
    <div class="card answer">
      <span class="avatar sm"><%= initials(a.user_name || '?') %></span>
      <div style="min-width:0">
        <div class="answer-head"><strong><%= a.user_name || 'Onbekend' %></strong><span class="small muted"><%= timeAgo(a.created_at) %></span></div>
        <div class="post-body"><%= a.body %></div>
        <% if (a.user_id === user.id || user.is_admin) { %>
          <form method="post" action="/vragen/antwoord/<%= a.id %>/verwijderen" data-confirm="Dit antwoord verwijderen?" style="margin-top:.4rem">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn ghost sm" type="submit" style="padding-left:0"><%- icon('trash') %> Verwijderen</button>
          </form>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

<section class="card" style="margin-top:1rem">
  <h2>Jouw antwoord</h2>
  <form method="post" action="/vragen/<%= question.id %>/antwoord">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label class="sr-only" for="a-body">Antwoord</label>
      <textarea id="a-body" name="body" required maxlength="5000" placeholder="Deel je oplossing of tip…"></textarea></div>
    <button class="btn block" type="submit">Antwoord plaatsen</button>
  </form>
</section>
<%- include('partials/footer') %>
