<%- include('partials/header') %>
<div class="page-head">
  <div><h1>Materialen uitlenen</h1><p>Leen gereedschap en spullen van collega's, of bied zelf iets aan.</p></div>
</div>

<details class="expand" id="nieuw">
  <summary><%- icon('plus') %> Materiaal aanbieden <%- icon('chev-down', 'chev') %></summary>
  <div class="body">
    <form method="post" action="/materialen">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="m-name">Wat is het?</label>
        <input id="m-name" name="name" type="text" required maxlength="100" placeholder="Bijv. boormachine, ladder, hogedrukreiniger"></div>
      <div class="field"><label for="m-desc">Omschrijving <span class="muted small">(optioneel)</span></label>
        <textarea id="m-desc" name="description" maxlength="1000" placeholder="Merk, staat, wat er bij zit…"></textarea></div>
      <div class="field"><label for="m-school">Staat op locatie</label>
        <select id="m-school" name="school_id">
          <% schools.forEach(s => { %><option value="<%= s.id %>" <%= mySchools[0] === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
        </select></div>
      <button class="btn block" type="submit">Toevoegen</button>
    </form>
  </div>
</details>

<div class="search">
  <%- icon('search') %>
  <input type="search" placeholder="Zoek materiaal…" data-filter=".item-card" aria-label="Zoek materiaal">
</div>

<% if (!materials.length) { %>
  <div class="card empty"><%- icon('box') %><p>Er staat nog geen materiaal in de lijst. Bied als eerste iets aan!</p></div>
<% } %>

<div class="grid grid-2">
  <% materials.forEach(m => { const lent = Boolean(m.loan_id); const overdue = lent && m.due_date && m.due_date < todayISO(); %>
    <article class="card item-card" data-text="<%= (m.name + ' ' + m.description + ' ' + (m.school_name || '')).toLowerCase() %>">
      <div class="item-head">
        <h3><%= m.name %></h3>
        <% if (!lent) { %><span class="badge ok">Beschikbaar</span>
        <% } else if (overdue) { %><span class="badge danger">Te laat</span>
        <% } else { %><span class="badge warn">Uitgeleend</span><% } %>
      </div>
      <% if (m.description) { %><p class="small post-body" style="margin:0"><%= m.description %></p><% } %>
      <div class="item-meta">
        <span><%- icon('school') %> <%= m.school_name || 'Onbekende locatie' %></span>
        <span><%- icon('user') %> <%= m.owner_name || 'Onbekend' %></span>
      </div>
      <% if (lent) { %>
        <div class="small" style="padding:.6rem .75rem;border-radius:10px;background:var(--surface-2)">
          <%- icon('swap') %> Geleend door <strong><%= m.borrower_id === user.id ? 'jou' : (m.borrower_name || 'onbekend') %></strong>
          <% if (m.loan_school) { %>naar <%= m.loan_school %><% } %>
          <% if (m.due_date) { %>· terug op <%= formatDate(m.due_date) %><% } %>
        </div>
      <% } %>
      <div class="btn-row">
        <% if (!lent) { %>
          <button class="btn sm" type="button" data-toggle="loan-<%= m.id %>"><%- icon('swap') %> Lenen</button>
        <% } else if (m.borrower_id === user.id || m.owner_id === user.id || user.is_admin) { %>
          <form class="inline" method="post" action="/materialen/<%= m.id %>/terug">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn secondary sm" type="submit"><%- icon('check') %> Teruggebracht</button>
          </form>
        <% } %>
        <% if (m.owner_id === user.id || user.is_admin) { %>
          <form class="inline" method="post" action="/materialen/<%= m.id %>/verwijderen" data-confirm="Weet je zeker dat je '<%= m.name %>' wilt verwijderen?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn danger sm" type="submit" aria-label="Verwijderen"><%- icon('trash') %></button>
          </form>
        <% } %>
      </div>
      <% if (!lent) { %>
        <form class="loan-form" id="loan-<%= m.id %>" method="post" action="/materialen/<%= m.id %>/lenen" hidden>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row-2">
            <div><label for="due-<%= m.id %>">Terug op</label>
              <input id="due-<%= m.id %>" type="date" name="due_date" min="<%= todayISO() %>" value="<%= todayISO(7) %>"></div>
            <div><label for="to-<%= m.id %>">Naar locatie</label>
              <select id="to-<%= m.id %>" name="school_id">
                <% schools.forEach(s => { %><option value="<%= s.id %>" <%= mySchools[0] === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %>
              </select></div>
          </div>
          <input type="text" name="note" maxlength="300" placeholder="Opmerking (optioneel)" aria-label="Opmerking">
          <button class="btn block" type="submit">Bevestig lenen</button>
        </form>
      <% } %>
    </article>
  <% }) %>
</div>
<%- include('partials/footer') %>
