<%- include('partials/header') %>
<%
  const images = files.filter(f => f.mimetype.startsWith('image/'));
  const videos = files.filter(f => f.mimetype.startsWith('video/'));
  const docs = files.filter(f => f.mimetype === 'application/pdf');
%>
<a class="back" href="/tutorials"><%- icon('chev-left') %> Tutorials</a>

<article class="stack">
  <header>
    <span class="badge primary"><%= tutorial.category %></span>
    <h1 style="margin-top:.5rem;overflow-wrap:anywhere"><%= tutorial.title %></h1>
    <p class="small muted"><%- icon('user') %> <%= tutorial.user_name || 'Onbekend' %> · <%= formatDateTime(tutorial.created_at) %></p>
  </header>

  <% if (images.length) { %>
    <a href="/tutorials/bestand/<%= images[0].filename %>" target="_blank" rel="noopener">
      <img src="/tutorials/bestand/<%= images[0].filename %>" alt="<%= images[0].original_name %>" style="width:100%;max-height:420px;object-fit:cover;border-radius:var(--radius)">
    </a>
  <% } %>

  <% if (tutorial.description) { %>
    <section class="card"><h2>Waar gaat het over?</h2><p class="post-body" style="margin:0"><%= tutorial.description %></p></section>
  <% } %>

  <% if (steps.length) { %>
    <section class="card">
      <h2>Stappen</h2>
      <ol class="steps"><% steps.forEach(s => { %><li><%= s %></li><% }) %></ol>
    </section>
  <% } %>

  <% if (videos.length) { %>
    <section class="card video-wrap"><h2>Video</h2>
      <% videos.forEach(v => { %>
        <video controls playsinline preload="metadata" src="/tutorials/bestand/<%= v.filename %>"></video>
      <% }) %>
    </section>
  <% } %>

  <% if (images.length > 1) { %>
    <section class="card"><h2>Foto's</h2>
      <div class="gallery">
        <% images.forEach(i => { %>
          <a href="/tutorials/bestand/<%= i.filename %>" target="_blank" rel="noopener"><img src="/tutorials/bestand/<%= i.filename %>" alt="<%= i.original_name %>" loading="lazy"></a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (docs.length) { %>
    <section class="card"><h2>Documenten</h2>
      <ul class="list">
        <% docs.forEach(d => { %>
          <li><a class="row-link" href="/tutorials/bestand/<%= d.filename %>" target="_blank" rel="noopener"><%- icon('file') %><span class="grow title"><%= d.original_name %></span><%- icon('chev-right', 'muted') %></a></li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <% if (tutorial.user_id === user.id || user.is_admin) { %>
    <form method="post" action="/tutorials/<%= tutorial.id %>/verwijderen" data-confirm="Deze tutorial verwijderen?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn danger" type="submit"><%- icon('trash') %> Tutorial verwijderen</button>
    </form>
  <% } %>
</article>
<%- include('partials/footer') %>
