<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0f766e">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Conciërges">
  <title><%= title ? title + ' · ' : '' %>Conciërgeportaal</title>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.svg">
  <% if (typeof useMap !== 'undefined' && useMap) { %>
  <link rel="stylesheet" href="/vendor/leaflet/leaflet.css">
  <% } %>
  <link rel="stylesheet" href="/style.css">
</head>
<%
  const showNav = user && user.setup_done;
  const navItems = [
    { href: '/', label: 'Home', icon: 'home', tab: true },
    { href: '/materialen', label: 'Materialen', short: 'Materiaal', icon: 'box', tab: true },
    { href: '/meetings', label: 'Meetings', icon: 'calendar', tab: true },
    { href: '/vragen', label: 'Vragen & antwoorden', short: 'Vragen', icon: 'help', tab: true },
    { href: '/tutorials', label: 'Tutorials', icon: 'tool', tab: true },
  ];
  const extraItems = [
    { href: '/collegas', label: "Collega's", icon: 'users' },
    { href: '/setup', label: 'Mijn locaties', icon: 'pin' },
    { href: '/profiel', label: 'Mijn profiel', icon: 'user' },
  ];
  if (user && user.is_admin) extraItems.push({ href: '/admin/scholen', label: 'Beheer', icon: 'shield' });
  const isActive = (href) => href === '/' ? path === '/' : path.startsWith(href);
%>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<%- include('icons') %>
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark"><%- icon('school') %></span>
    <span>Conciërgeportaal</span>
  </a>
  <span class="spacer"></span>
  <% if (user) { %>
    <a class="avatar" href="/profiel" title="Mijn profiel" aria-label="Mijn profiel"><%= initials(user.name) %></a>
  <% } %>
</header>
<div class="layout<%= showNav ? '' : ' no-nav' %>">
  <% if (showNav) { %>
  <nav class="sidebar" aria-label="Hoofdmenu">
    <% navItems.forEach(item => { %>
      <a href="<%= item.href %>" class="<%= isActive(item.href) ? 'active' : '' %>"><%- icon(item.icon) %> <%= item.label %></a>
    <% }) %>
    <div class="sep"></div>
    <% extraItems.forEach(item => { %>
      <a href="<%= item.href %>" class="<%= isActive(item.href) ? 'active' : '' %>"><%- icon(item.icon) %> <%= item.label %></a>
    <% }) %>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn ghost block" type="submit"><%- icon('logout') %> Uitloggen</button>
    </form>
  </nav>
  <% } %>
  <main class="content">
    <% flash.forEach(f => { %>
      <div class="flash <%= f.type %>" role="status"><%- icon(f.type === 'error' ? 'alert' : 'check') %> <span><%= f.message %></span></div>
    <% }) %>
