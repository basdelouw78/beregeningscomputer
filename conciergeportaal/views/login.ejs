<%- include('partials/header', { bodyClass: 'auth-page' }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-hero">
      <div class="brand-mark"><%- icon('school') %></div>
      <h1>Welkom terug</h1>
      <p>Log in op het portaal voor conciërges.</p>
    </div>
    <div class="card">
      <% if (typeof error !== 'undefined') { %>
        <div class="flash error" role="alert"><%- icon('alert') %> <span><%= error %></span></div>
      <% } %>
      <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="email">E-mailadres</label>
          <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required value="<%= email %>" autofocus>
        </div>
        <div class="field">
          <label for="password">Wachtwoord</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn block" type="submit">Inloggen</button>
      </form>
    </div>
    <p class="auth-switch">Nog geen account? <a href="/registreren">Account aanmaken</a></p>
  </div>
</div>
<%- include('partials/footer') %>
