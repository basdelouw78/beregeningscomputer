<%- include('partials/header', { useMap: true }) %>
<div class="page-head">
  <div><h1>Beheer</h1><p>Scholen op de kaart en beheerders.</p></div>
</div>

<section class="card">
  <h2>School toevoegen</h2>
  <p class="small muted">Tik op de kaart om de locatie te kiezen, of sleep de oranje speld.</p>
  <div id="admin-map" class="map map-sm"></div>
  <form method="post" action="/admin/scholen" style="margin-top:1rem" id="school-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="s-name">Naam</label><input id="s-name" name="name" type="text" required maxlength="120"></div>
    <div class="field"><label for="s-addr">Adres</label><input id="s-addr" name="address" type="text" maxlength="200"></div>
    <div class="row-2 field">
      <div><label for="s-lat">Breedtegraad</label><input id="s-lat" name="lat" type="text" inputmode="decimal" required></div>
      <div><label for="s-lng">Lengtegraad</label><input id="s-lng" name="lng" type="text" inputmode="decimal" required></div>
    </div>
    <button class="btn block" type="submit"><%- icon('plus') %> School toevoegen</button>
  </form>
</section>

<section class="card">
  <h2>Scholen (<%= schools.length %>)</h2>
  <div class="stack">
    <% schools.forEach(s => { %>
      <details class="expand" style="box-shadow:none;margin:0">
        <summary style="color:var(--text)"><%- icon('school') %> <span class="grow"><%= s.name %> <span class="small muted">· <%= s.people %> conciërge<%= s.people === 1 ? '' : 's' %></span></span> <%- icon('chev-down', 'chev') %></summary>
        <div class="body">
          <form method="post" action="/admin/scholen/<%= s.id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label>Naam</label><input name="name" type="text" value="<%= s.name %>" required maxlength="120"></div>
            <div class="field"><label>Adres</label><input name="address" type="text" value="<%= s.address %>" maxlength="200"></div>
            <div class="row-2 field">
              <div><label>Breedtegraad</label><input name="lat" type="text" inputmode="decimal" value="<%= s.lat %>"></div>
              <div><label>Lengtegraad</label><input name="lng" type="text" inputmode="decimal" value="<%= s.lng %>"></div>
            </div>
            <button class="btn sm" type="submit">Opslaan</button>
          </form>
          <form method="post" action="/admin/scholen/<%= s.id %>/verwijderen" style="margin-top:.5rem" data-confirm="<%= s.name %> verwijderen? Roosters van conciërges op deze school worden ook verwijderd.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn danger sm" type="submit"><%- icon('trash') %> Verwijderen</button>
          </form>
        </div>
      </details>
    <% }) %>
  </div>
</section>

<section class="card">
  <h2>Gebruikers</h2>
  <ul class="list">
    <% users.forEach(u => { %>
      <li>
        <span class="avatar sm"><%= initials(u.name) %></span>
        <span class="grow"><span class="title"><%= u.name %> <% if (u.is_admin) { %><span class="badge primary">beheerder</span><% } %></span><span class="small muted"><%= u.email %></span></span>
        <% if (u.id !== user.id) { %>
          <form class="inline" method="post" action="/admin/gebruikers/<%= u.id %>/admin">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn secondary sm" type="submit"><%= u.is_admin ? 'Rechten intrekken' : 'Maak beheerder' %></button>
          </form>
        <% } %>
      </li>
    <% }) %>
  </ul>
</section>
<script type="application/json" id="schools-data"><%- json(schools) %></script>
<%- include('partials/footer', { useMap: true }) %>
