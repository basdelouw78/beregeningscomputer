<%- include('partials/header', { useMap: true }) %>
<div class="page-head">
  <div><h1>Collega's</h1><p>Wie werkt waar, en wanneer?</p></div>
</div>

<div id="colleagues-map" class="map map-sm" aria-label="Kaart met scholen en conciërges"></div>

<div class="search" style="margin-top:1rem">
  <%- icon('search') %>
  <input type="search" placeholder="Zoek op naam of school…" data-filter=".person" aria-label="Zoeken">
</div>

<div class="grid grid-2">
  <% people.forEach(p => { %>
    <div class="card person" data-text="<%= (p.name + ' ' + p.locations.map(l => l.school_name).join(' ')).toLowerCase() %>">
      <div class="card-title" style="justify-content:flex-start;gap:.75rem">
        <span class="avatar"><%= initials(p.name) %></span>
        <div class="grow"><h3 style="margin:0"><%= p.name %></h3>
          <span class="small muted"><%= p.email %></span></div>
      </div>
      <% p.locations.forEach(loc => { %>
        <div class="small" style="margin-bottom:.35rem"><strong><%= loc.school_name %></strong><br>
          <span class="muted"><%= loc.days.map(d => DAYS[d.day - 1].short + ' ' + d.start_time + '–' + d.end_time).join(' · ') %></span></div>
      <% }) %>
      <div class="btn-row" style="margin-top:.6rem">
        <% if (p.phone) { %><a class="btn secondary sm" href="tel:<%= p.phone.replace(/[^\d+]/g, '') %>"><%- icon('phone') %> Bellen</a><% } %>
        <a class="btn secondary sm" href="mailto:<%= p.email %>"><%- icon('mail') %> Mailen</a>
      </div>
    </div>
  <% }) %>
</div>
<script type="application/json" id="schools-data"><%- json(bySchool) %></script>
<%- include('partials/footer', { useMap: true }) %>
