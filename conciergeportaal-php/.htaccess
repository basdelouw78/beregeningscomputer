# Conciërgeportaal — Apache-instellingen (Strato)
Options -Indexes
AddType application/manifest+json .webmanifest
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Gevoelige bestanden nooit rechtstreeks tonen
  RewriteRule ^(app|uploads)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|README\.md|LEESMIJ\.md|\.user\.ini)$ - [F,L]

  # Bestaande bestanden (CSS, JS, plaatjes) gewoon leveren
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Al het andere gaat via index.php
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
